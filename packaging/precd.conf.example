# Destination JSONL log file.
# log_path = "/var/log/prec/prec.log"

# Log compression mode.
# Supported: "no", "gz", "zstd" (default: "zstd")
# compress = "zstd"

# Compression level for selected compressor.
# gzip: -3..9 (default when omitted: -1)
# zstd: 1..22 (default when omitted: 3)
# no: ignored
# compress_level = 3

# Enable file_open event collection from openat. Without capture_filter, only
# write-capable opens are sent to the perf ring.
# collect_file_open = false

# Enable file_save event collection from write-family syscalls.
# collect_file_save = false

# File event source scope.
# Supported: "user" (default), "system", "any"
# collect_file_source = "user"

# File path scope for collected file events.
# "user_visible" keeps user-home files and excludes common hidden app-state paths.
# Supported: "user_visible" (default), "home", "all"
# collect_file_scope = "user_visible"

# Suppress repeated file_save records for the same process and file path
# within the configured number of seconds.
# Set to 0 to disable suppression.
# file_save_dedup_sec = 1

# Early allowlist applied in eBPF before events reach the perf ring.
# Rules and || terms are ORed. Each rule must start with + and clauses use && for AND.
# Supported fields: uid, gid, pid, user, group, comm (comm is exact match).
# user/group names are resolved when precd starts.
# Fields such as exe, argv, file_path, record_type, and source are not
# available at this stage and cause precd startup to fail if specified.
# capture_filter = [
#   "+uid>=1000",
#   "+user=apache",
#   "+user=nginx",
#   "+comm=php-fpm",
# ]
# capture_filter = []
# When collect_file_open=true and capture_filter is non-empty, matching
# read-only opens are also recorded. Keep this allowlist narrow to avoid logs
# growing rapidly on busy services.

# Store only source=user events when true.
# Example: user_only = true
# user_only = false

# Action when the perf ring reports dropped samples.
# "log": write collector_loss records with dropped counts (default)
# "ignore": do not write dropped-sample records
# "stop": write collector_loss record, then stop precd with an error
# lost_samples_action = "log"

# Default action when no filter rule matches.
# Supported: "allow", "deny" (default: "allow")
# filter_default = "allow"

# Ordered filter rules.
# Prefix each rule with:
#   + to allow matched events
#   - to deny matched events
# Rules are evaluated from top to bottom. The first matched rule wins.
# Query syntax follows prec --query.
# Example:
# filter = [
#   "-exe~=ls",
#   "-exe~=dnf",
#   "+source=user&&uid>=1000",
# ]
# filter = []

# Maximum characters recorded per single argument.
# max_arg_length = 1024

# Maximum number of arguments to record.
# max_args = 128
